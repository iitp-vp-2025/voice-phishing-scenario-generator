# Copy this file to .env for local use.
# Do not commit .env.

# NewsAPI key is only needed for generation/keyword_collector.py.
NEWS_API_KEY=your_newsapi_key_here

# sLLM server settings.
SLLM_API_URL=https_or_http_url_to_your_sllm_generate_endpoint
SLLM_MODEL=your_model_name
SLLM_TEMPERATURE=0
SLLM_TOP_P=1
SLLM_SEED=42

# Optional CSV/JSONL containing label=1 call transcripts. If left empty,
# references/positive_format_refs.jsonl is used automatically when it exists.
# These raw examples are used only for generation and are never sent to R or KEV.
VP_GENERATION_REFERENCE_PATH=
VP_GENERATION_REFERENCE_COUNT=3

# KEV local decision-model server. The evaluator appends /v1/systemone.
KEV_API_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
# Optional when the KEV server enables authentication.
KEV_API_KEY=

# Optional R axis: private fine-tuned DistilKoBERT state_dict (not included in Git).
# When this file is missing or the value is empty, evaluation runs with KEV A-D only.
DISTILKOBERT_MODEL_PATH=best_student.pt
# Optional. Empty means the monologg/distilkobert tokenizer on Hugging Face.
DISTILKOBERT_TOKENIZER_PATH=
DISTILKOBERT_DEVICE=auto
DISTILKOBERT_THRESHOLD=0.5

# Optional alternative name used by the scripts.
# OLLAMA_API_URL=https_or_http_url_to_your_sllm_generate_endpoint
